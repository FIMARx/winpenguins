root = true

[*.cs]
charset = utf-8
end_of_line = crlf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

# Style rules kept practical across a multi-type WinForms + Direct2D codebase
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.CA1805.severity = none
dotnet_diagnostic.CA1051.severity = none
dotnet_diagnostic.CA1859.severity = none
dotnet_diagnostic.CA1822.severity = none
dotnet_diagnostic.CA1861.severity = none
dotnet_diagnostic.CA1869.severity = none
dotnet_diagnostic.CA1819.severity = none
dotnet_diagnostic.MA0048.severity = none
dotnet_diagnostic.MA0051.severity = none
dotnet_diagnostic.MA0046.severity = none
dotnet_diagnostic.MA0016.severity = none
dotnet_diagnostic.MA0004.severity = none

# Real bug catchers: culture safety, ignored return values, locks, disposables
dotnet_diagnostic.CA1806.severity = warning
dotnet_diagnostic.CA1305.severity = warning
dotnet_diagnostic.MA0011.severity = warning
dotnet_diagnostic.MA0002.severity = warning
dotnet_diagnostic.MA0158.severity = warning
dotnet_diagnostic.MA0099.severity = warning
dotnet_diagnostic.IDISP004.severity = warning
dotnet_diagnostic.IDISP006.severity = warning
dotnet_diagnostic.IDISP007.severity = warning
dotnet_diagnostic.IDISP008.severity = warning
dotnet_diagnostic.IDISP009.severity = warning
dotnet_diagnostic.IDISP015.severity = warning

# Strict disposal tracking on non-UI layers (Engine, Assets, Platform, Config, Diagnostics)
dotnet_diagnostic.IDISP001.severity = warning
dotnet_diagnostic.IDISP002.severity = warning
dotnet_diagnostic.IDISP003.severity = warning

# WinForms owns Controls added via Controls.Add(...), triggering false positives on Form fields/locals
[src/WinPenguins/UI/*.cs]
dotnet_diagnostic.IDISP001.severity = none
dotnet_diagnostic.IDISP002.severity = none
dotnet_diagnostic.IDISP003.severity = none
dotnet_diagnostic.IDISP008.severity = none
dotnet_diagnostic.IDISP015.severity = none

[tests/**/*.cs]
dotnet_diagnostic.CA1305.severity = none
dotnet_diagnostic.MA0011.severity = none
dotnet_diagnostic.IDISP001.severity = none
dotnet_diagnostic.IDISP002.severity = none
dotnet_diagnostic.IDISP003.severity = none
dotnet_diagnostic.IDISP004.severity = none
